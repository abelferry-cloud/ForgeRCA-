# ForgeRCA 环境变量模板（M0-10）
#
# 用法：本地复制为 .env 后按实际环境填写。.env 已被 .gitignore 忽略，
# 请勿提交；本文件只登记参数名与占位说明，任何真实密钥、口令或连接串都不得写入仓库。
# 密钥材料另见 SECURITY.md 的处置流程。M1-04 的 Compose 已读取数据库凭据与端口；
# M1-20 已接入北京地域 Embedding API；生成与追踪参数尚未接入运行流程。

# --- PostgreSQL：M1-04 本地服务；M1-17 迁移使用同名进程环境变量 ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=forgerca
POSTGRES_USER=forgerca
POSTGRES_PASSWORD=

# --- OpenSearch：M1-04 本地服务；索引与应用接入在 M1-19 ---
# 本地 Compose 仅绑定 127.0.0.1，未启用认证；USER / PASSWORD 当前不用于启动容器。
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX_PREFIX=forgerca

# --- Neo4j：M1-04 本地服务；图谱入库在 M3-09 ---
# 更改 NEO4J_BOLT_PORT 时同步更改 NEO4J_URI。Compose 初始用户固定为 neo4j；
# NEO4J_USER 是应用连接用户，本地首次使用保持 neo4j。密码至少 8 个字符。
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- M1-20：阿里云百炼北京地域；模型身份与维度由 versions.lock.json 固定 ---
EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_API_KEY=
# 生成模型与 reranker 仍待后续里程碑接入。
RERANKER_MODEL=
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# --- Langfuse：逐次诊断的 trace 与 token 统计（M4-22 起使用）---
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
