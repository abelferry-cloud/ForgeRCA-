# ForgeRCA 环境变量模板（M0-10）
#
# 用法：本地复制为 .env 后按实际环境填写。.env 已被 .gitignore 忽略，
# 请勿提交；本文件只登记参数名与占位说明，任何真实密钥、口令或连接串都不得写入仓库。
# 密钥材料另见 SECURITY.md 的处置流程。当前仓库处于初始化阶段，没有服务会读取这些值。

# --- PostgreSQL：文档/片段元数据、导入任务与诊断记录（M1-17 起使用）---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=forgerca
POSTGRES_USER=forgerca
POSTGRES_PASSWORD=

# --- OpenSearch：BM25 与向量召回（M1-19 起使用）---
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX_PREFIX=forgerca

# --- Neo4j：证据约束图谱（M3-09 起使用）---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- 模型：M1 选型时填写完整标识，不要只写简称 ---
# embedding / reranker 为本地或自托管模型时不需要 KEY。
EMBEDDING_MODEL=
RERANKER_MODEL=
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# --- Langfuse：逐次诊断的 trace 与 token 统计（M4-22 起使用）---
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
